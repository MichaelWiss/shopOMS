# ===========================================
# shopOMS — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional — defaults to 2026-01
# SHOPIFY_API_VERSION=2026-01

# --- Odoo ---
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany-prod
ODOO_USERNAME=admin@yourcompany.com
ODOO_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis ---
# Local Docker: redis://localhost:6379
# Upstash: rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# --- Admin ---
# Used for admin dashboard login and API auth
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=

# --- Site Configuration ---
# These are used for contact info and branding throughout the storefront
NEXT_PUBLIC_SITE_NAME=Press & Co
NEXT_PUBLIC_CONTACT_EMAIL=hello@pressandco.com
NEXT_PUBLIC_CONTACT_PHONE=(+61) 400 000 000
NEXT_PUBLIC_INSTAGRAM_HANDLE=@pressandco
NEXT_PUBLIC_LOCATION=Melbourne, Australia
NEXT_PUBLIC_EST_YEAR=2024
NEXT_PUBLIC_CURRENCY_CODE=AUD
NEXT_PUBLIC_CURRENCY_SYMBOL=A$
